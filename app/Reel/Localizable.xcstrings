    "Add a debrid service in Settings to play Torrentio's sources.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge in den Einstellungen einen Debrid-Dienst hinzu, um Torrentios Quellen abzuspielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un servicio debrid en Ajustes para reproducir las fuentes de Torrentio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un service debrid dans les Réglages pour lire les sources de Torrentio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中添加 Debrid 服务即可播放 Torrentio 的片源。"
          }
        }
      }
    },
    "Add series to My List, or start watching one, and their new episodes appear here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Serien zu „Meine Liste“ hinzu oder fang eine an, dann erscheinen ihre neuen Folgen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade series a Mi lista o empieza a ver una, y sus nuevos episodios aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des séries à Ma liste ou commencez-en une, et leurs nouveaux épisodes apparaîtront ici."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把剧集加入“我的片单”或开始观看，它们的新剧集就会显示在这里。"
          }
        }
      }
    },
