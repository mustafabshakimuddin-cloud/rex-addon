          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stremio 插件"
          }
        }
      }
    },
    "Stremio addons such as Comet or MediaFusion add their results to Torrentio's, so a title still plays when one of them is down.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stremio-Add-ons wie Comet oder MediaFusion ergänzen Torrentios Ergebnisse, sodass ein Titel auch dann läuft, wenn eines ausfällt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Complementos de Stremio como Comet o MediaFusion suman sus resultados a los de Torrentio, así un título sigue reproduciéndose cuando uno falla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des addons Stremio comme Comet ou MediaFusion ajoutent leurs résultats à ceux de Torrentio, pour qu’un titre reste lisible quand l’un d’eux est en panne."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Comet 或 MediaFusion 等 Stremio 插件会把结果加入 Torrentio 的结果中，即使其中一个不可用，内容也能播放。"
          }
        }
      }
    },
