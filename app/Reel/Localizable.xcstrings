    "What Play picks: instant first, then your quality order and source preferences, then what has played well for you before.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was „Abspielen“ wählt: zuerst Sofortiges, dann deine Qualitätsreihenfolge und Quellenvorlieben, dann was bei dir gut lief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que elige Reproducir: primero lo instantáneo, luego tu orden de calidad y tus preferencias, luego lo que te funcionó antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Lecture choisit : l’instantané d’abord, puis votre ordre de qualité et vos préférences, puis ce qui a bien fonctionné pour vous."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“播放”的选择：先选即时片源，再按你的画质顺序和片源偏好，最后参考以前播放顺利的。"
          }
        }
      }
    },
