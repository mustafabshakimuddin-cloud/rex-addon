          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "串流"
          }
        }
      }
    },
    "Streams play through a debrid service such as Real-Debrid, or through a Stremio addon you add.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams laufen über einen Debrid-Dienst wie Real-Debrid oder über ein Stremio-Add-on, das du hinzufügst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transmisiones se reproducen a través de un servicio debrid como Real-Debrid o de un complemento de Stremio que añadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flux passent par un service debrid comme Real-Debrid, ou par un addon Stremio que vous ajoutez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "串流通过 Real-Debrid 等 Debrid 服务播放，或通过你添加的 Stremio 插件播放。"
          }
        }
      }
    },
    "Streams play through your debrid account: the release is fetched by the service and streamed to you over HTTPS. The key is stored in this device's Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams laufen über dein Debrid-Konto: Der Dienst holt das Release und streamt es dir über HTTPS. Der Schlüssel liegt im Schlüsselbund dieses Geräts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transmisiones pasan por tu cuenta debrid: el servicio obtiene la versión y te la transmite por HTTPS. La clave se guarda en el llavero de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flux passent par votre compte debrid : le service récupère la release et vous la diffuse en HTTPS. La clé est stockée dans le trousseau de cet appareil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "串流通过你的 Debrid 账户播放：服务会获取资源并通过 HTTPS 串流给你。密钥保存在本设备的钥匙串中。"
          }
        }
      }
    },
    "Stremio Addons": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
