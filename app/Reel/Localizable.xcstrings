{
  "sourceLanguage": "en",
  "strings": {
    "2× speed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2× Geschwindigkeit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidad 2×"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitesse 2×"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2倍速"
          }
        }
      }
    },
    "A copy you've finished watching is deleted this long after, to free space.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine fertig angesehene Kopie wird nach dieser Zeit gelöscht, um Platz zu schaffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia que terminaste de ver se elimina pasado este tiempo, para liberar espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie que vous avez fini de regarder est supprimée après ce délai, pour libérer de l’espace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看完的离线副本会在这段时间后删除，以释放空间。"
          }
        }
      }
    },
    "A debrid service fetches releases for you and streams them over HTTPS. Torrentio needs one to give playable links.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Debrid-Dienst holt Releases für dich und streamt sie über HTTPS. Torrentio braucht einen, um abspielbare Links zu liefern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un servicio debrid descarga los lanzamientos por ti y los transmite por HTTPS. Torrentio lo necesita para dar enlaces reproducibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un service debrid récupère les releases pour vous et les diffuse en HTTPS. Torrentio en a besoin pour fournir des liens lisibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Debrid 服务会替你获取资源并通过 HTTPS 串流播放。Torrentio 需要它才能提供可播放的链接。"
          }
        }
      }
    },
    "A self-hosted Torrentio can stand in for the public one. Languages listed here come first in Torrentio's results.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein selbst gehostetes Torrentio kann das öffentliche ersetzen. Hier genannte Sprachen stehen in Torrentios Ergebnissen vorn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Torrentio propio puede sustituir al público. Los idiomas de esta lista aparecen primero en los resultados de Torrentio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Torrentio auto-hébergé peut remplacer le serveur public. Les langues listées ici passent en premier dans les résultats de Torrentio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以用自建的 Torrentio 代替公共服务器。这里列出的语言会排在 Torrentio 结果的前面。"
          }
        }
      }
    },
