        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie „Abspielen“ auswählt und mit welchem Ton und welchen Untertiteln ein Titel startet. Das lässt sich später in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo elige Reproducir y qué audio y subtítulos empiezan con cada título. Todo esto se puede cambiar luego en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
