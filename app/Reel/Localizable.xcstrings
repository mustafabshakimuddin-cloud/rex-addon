        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态"
          }
        }
      }
    },
    "Status checks your debrid service, Torrentio, the catalogue and each addon, and says what to do about anything that fails.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Status prüft deinen Debrid-Dienst, Torrentio, den Katalog und jedes Add-on und sagt, was bei Fehlern zu tun ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado comprueba tu servicio debrid, Torrentio, el catálogo y cada complemento, y te dice qué hacer si algo falla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État vérifie votre service debrid, Torrentio, le catalogue et chaque addon, et indique quoi faire en cas d’échec."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“状态”会检查你的 Debrid 服务、Torrentio、片库和每个插件，并告诉你出问题时该怎么办。"
          }
        }
      }
    },
