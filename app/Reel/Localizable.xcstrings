        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el botón de descarga de una película, o mantén pulsado un episodio, para guardarlo y verlo sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le bouton de téléchargement d’un film, ou appuyez longuement sur un épisode, pour le garder et le regarder hors ligne."
