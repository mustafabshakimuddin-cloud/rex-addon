    "Resume points and watched marks on this device are removed. Trakt keeps its own history.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsetzungspunkte und Gesehen-Markierungen auf diesem Gerät werden entfernt. Trakt behält seinen eigenen Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan los puntos de reanudación y las marcas de visto de este dispositivo. Trakt conserva su propio historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les reprises et marques « vu » de cet appareil sont supprimées. Trakt garde son propre historique."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备上的播放进度和已看标记会被移除。Trakt 会保留自己的历史。"
          }
        }
      }
    },
